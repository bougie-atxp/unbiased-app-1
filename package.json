{
  "name": "unbiased-app",
  "version": "1.13.20",
  "description": "Unbiased desktop — Pareto-powered coding agent",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node build/dev-launcher.cjs",
    "build": "electron-vite build",
    "prepare:browser": "node build/prepare-browser.cjs",
    "smoke:browser": "node build/smoke-browser.cjs",
    "smoke:visual-preview": "electron build/smoke-visual-preview.cjs",
    "smoke:visual-scroll": "electron build/smoke-visual-scroll.cjs",
    "smoke:completed-visuals": "electron build/smoke-completed-visuals.cjs",
    "typecheck": "tsc --noEmit",
    "dist": "npm run prepare:browser && electron-vite build && electron-builder --publish never",
    "test": "node --import tsx --test src/main/*.test.ts src/renderer/src/*.test.ts"
  },
  "build": {
    "appId": "ai.unbiased.desktop",
    "productName": "Unbiased",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/unbiased/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "licenses/unbiased/NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/unbiased/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../unbiased-app-engine/dist/bundle",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../unbiased-ax/dist",
        "to": "ax",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/browser-bundle",
        "to": "browser",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/renderer/src/robot-heads/LICENSE",
        "to": "licenses/robot-heads/LICENSE"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty/**",
      "node_modules/@nut-tree-fork/libnut-darwin/**",
      "node_modules/@nut-tree-fork/node-mac-permissions/**",
      "node_modules/node-mac-permissions/**"
    ],
    "npmRebuild": false,
    "afterPack": "build/adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Unbiased ${version}"
    }
  },
  "keywords": [],
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@openuidev/react-lang": "0.3.2",
    "@openuidev/react-ui": "0.17.0",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "konva": "^10.7.1",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.17.2",
    "node-mac-permissions": "^2.5.0",
    "parse5": "^8.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^26.6.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-mac-permissions@2.5.0": true
  },
  "private": true
}
